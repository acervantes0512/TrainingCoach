# Training Coach API - Environment Variables
# Copy to .env and fill in values

# Server port (Railway injects PORT automatically)
PORT=3000

# API key for MCP authentication - generate with: openssl rand -hex 32
API_KEY=your-secure-api-key-here

# Frontend URL for CORS (Vercel URL in production)
FRONTEND_URL=http://localhost:4200

# Database path (use persistent volume path on Railway)
DB_PATH=./training-coach.db
